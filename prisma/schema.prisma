generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  ENVIADO
  RETORNANDO
  ENTREGADO
  CANCELADO
  DEVUELTO
}

enum InventoryMovementType {
  AJUSTE_MANUAL
  RESERVA_PEDIDO
  LIBERACION_PEDIDO
  SALIDA_PEDIDO
  REPOSICION_PEDIDO
}

enum ReturnCondition {
  APTO_VENTA
  DANADO
  INSPECCION
}

enum ShippingType {
  FIXED
  FREE
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  imageUrl    String?
  status      EntityStatus @default(ACTIVE)
  parentId    String?
  parent      Category?    @relation("SubCategories", fields: [parentId], references: [id])
  subCategories Category[] @relation("SubCategories")
  createdAt   DateTime     @default(now())
  products    Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  description   String
  price         Decimal      @db.Decimal(10, 2)
  previousPrice Decimal?     @db.Decimal(10, 2)
  stock         Int          @default(0)
  reservedStock Int          @default(0)
  sku           String       @unique
  imageUrl      String
  images        String[]     @default([])
  status        EntityStatus @default(INACTIVE)
  featured      Boolean      @default(false)
  categoryId    String
  category      Category         @relation(fields: [categoryId], references: [id])
  createdAt     DateTime         @default(now())
  orderItems    OrderItem[]
  returnItems   ReturnItem[]
  variants      ProductVariant[]
  inventoryMovements InventoryMovement[]

  @@index([slug])
  @@index([categoryId])
  @@index([featured])
  @@map("products")
}

model ProductVariant {
  id        String       @id @default(uuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String       @unique
  price     Decimal      @db.Decimal(10, 2)
  stock     Int          @default(0)
  reservedStock Int      @default(0)
  images    String[]     @default([])
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orderItems OrderItem[]
  returnItems ReturnItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  status        OrderStatus   @default(PENDIENTE)
  subtotal      Decimal       @db.Decimal(10, 2)
  shippingCost  Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)

  // Datos del cliente (snapshot)
  customerName  String
  customerPhone String
  customerEmail String?

  // Dirección de entrega
  department    String
  municipality  String
  exactAddress  String
  reference     String?

  createdAt DateTime    @default(now())
  items     OrderItem[]
  returnItems ReturnItem[]

  // Cancelación y Devolución
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?
  returnedAt         DateTime?
  returnReason       String?
  returnedBy         String?
  returningAt        DateTime?
  returningReason    String?
  returningBy        String?
  stockRestored      Boolean       @default(false)

  // Inventario y Reservas (T-001, DT-001, DT-006)
  inventoryReserved  Boolean       @default(false)
  inventoryShipped   Boolean       @default(false)
  inventoryReleased  Boolean       @default(false)
  inventoryMovements InventoryMovement[]

  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String          // snapshot del nombre al momento del pedido
  variantName String?         // snapshot del nombre de la variante al momento del pedido
  sku         String?         // snapshot del SKU al momento del pedido
  unitPrice   Decimal         @db.Decimal(10, 2) // snapshot del precio
  quantity    Int

  @@map("order_items")
}

model ReturnItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku         String
  quantity    Int
  condition   ReturnCondition
  restocked   Boolean        @default(false)
  reason      String?
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("return_items")
}

model Setting {
  id               String       @id @default(uuid())
  storeName        String       @default("E-COMMERCE")
  logoUrl          String?
  footerTagline    String?      @default("Tu tienda de confianza con pago contra entrega en toda Guatemala.")
  footerCopyright  String?      @default("Todos los derechos reservados. Pago contra entrega garantizado.")
  shippingType     ShippingType @default(FIXED)
  shippingAmount   Decimal      @default(30) @db.Decimal(10, 2)
  bannerImageUrl   String?
  bannerText       String?
  bannerLinkUrl    String?
  metaPixelId      String?
  
  quickLinksActive Boolean      @default(true)
  quickLinks       Json?

  @@map("settings")
}

model BannerSlide {
  id        String   @id @default(uuid())
  imageUrl  String
  text      String?
  linkUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("banner_slides")
}

model InventoryMovement {
  id                 String                @id @default(uuid())
  type               InventoryMovementType
  productId          String?
  product            Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  variant            ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku                String
  quantityChange     Int                   @default(0)
  reservedChange     Int                   @default(0)
  stockAfter         Int
  reservedStockAfter Int
  reason             String?
  actor              String?
  orderId            String?
  order              Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now())

  @@index([sku])
  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([createdAt])
  @@map("inventory_movements")
}
